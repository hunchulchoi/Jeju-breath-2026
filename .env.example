# Claude API 키 (서버에서만 사용, 브라우저로 보내지 않음)
ANTHROPIC_API_KEY=
# 제보자 ID 해시용 salt (아무 긴 랜덤 문자열)
USER_HASH_SALT=change-me
# true면 시연용 테스트 좌표 토글과 배지를 보여 줌. 운영에서는 false
DEMO_MODE=true
# 카카오 오픈빌더 스킬(/api/kakao/skill) 호출 비밀. 오픈빌더 스킬 설정의 헤더 X-Skill-Secret에 같은 값을 넣는다.
# 비어 있으면 스킬이 503으로 거부한다. 긴 랜덤 문자열을 쓴다.
KAKAO_SKILL_SECRET=
# 카카오 링크에 넣을 서비스 주소 (예: https://jeju.example.com, 끝 슬래시 없이). 비우면 요청 주소를 쓴다.
PUBLIC_BASE_URL=

# stage 서버 Postgres. jeju_breath 계정은 TLS 없는 접속이 거부된다.
# 서버 인증서는 자체 서명이라 verify-full 대신 인증서 고정(verify-ca)으로 확인한다. 주소는 내부 위키 '인프라' 참고.
DATABASE_URL="postgres://jeju_breath:PASSWORD@<db-host>:5432/jeju_breath?sslmode=verify-ca&sslrootcert=certs/stage-postgres.crt&uselibpqcompat=true"

# stage 서버 MinIO. HTTPS 주소(Traefik 경유)를 쓴다. 버킷 이름에는 밑줄을 쓸 수 없어 jeju-breath
S3_ENDPOINT=https://<s3-host>
S3_REGION=us-east-1
S3_BUCKET=jeju-breath
S3_ACCESS_KEY_ID=jeju_breath
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
