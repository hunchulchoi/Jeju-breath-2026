# Claude API 키 (서버에서만 사용, 브라우저로 보내지 않음)
ANTHROPIC_API_KEY=
# 제보자 ID 해시용 salt (아무 긴 랜덤 문자열)
USER_HASH_SALT=change-me
# true면 시연용 테스트 좌표 토글과 배지를 보여 줌. 운영에서는 false
DEMO_MODE=true

# stage 서버 Postgres. jeju_breath 계정은 TLS 없는 접속이 거부된다.
# 서버 인증서는 자체 서명이고 이름에 <stage-host>가 없어 verify-full 대신 인증서 고정(verify-ca)으로 확인한다.
DATABASE_URL="postgres://jeju_breath:PASSWORD@<stage-host>:5432/jeju_breath?sslmode=verify-ca&sslrootcert=certs/stage-postgres.crt&uselibpqcompat=true"

# stage 서버 MinIO (버킷 이름에는 밑줄을 쓸 수 없어 jeju-breath)
S3_ENDPOINT=http://<stage-host>:9000
S3_REGION=us-east-1
S3_BUCKET=jeju-breath
S3_ACCESS_KEY_ID=jeju_breath
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
